---
import MotifMark from './MotifMark.astro';
import { SITE } from '../lib/site';

const COLUMNS = [
  {
    title: 'Product',
    links: [
      { href: '#how', label: 'How it works' },
      { href: '#models', label: 'Models' },
      { href: '#cleanup', label: 'Cleanup tiers' },
      { href: '#privacy', label: 'Privacy' },
    ],
  },
  {
    title: 'Source',
    links: [
      { href: SITE.repo, label: 'Repository' },
      { href: SITE.releases, label: 'Releases' },
      { href: SITE.issues, label: 'Issues' },
      { href: `${SITE.repo}/blob/main/README.md`, label: 'README' },
    ],
  },
  {
    title: 'Built on',
    links: [
      { href: 'https://github.com/argmaxinc/WhisperKit', label: 'WhisperKit' },
      { href: 'https://github.com/openai/whisper', label: 'Whisper' },
      { href: 'https://github.com/ml-explore/mlx-swift', label: 'MLX Swift' },
    ],
  },
];
---

<footer class="footer">
  <div class="page footer__inner">
    <div class="footer__brand">
      <MotifMark size={32} class="fg-brand" />
      <p class="heading-sm">Wordstream</p>
      <p class="body-sm fg-tertiary">
        Hold a key. Talk. Your words land where your cursor is.
      </p>
    </div>

    <div class="footer__columns">
      {
        COLUMNS.map((column) => (
          <div class="footer__column">
            <p class="label fg-tertiary">{column.title}</p>
            <ul role="list">
              {column.links.map((link) => (
                <li>
                  <a class="body-sm footer__link" href={link.href} rel="noopener">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>

  <div class="page footer__base">
    <p class="caption fg-tertiary">
      {SITE.license} licensed. Not affiliated with OpenAI, Apple, or Wispr.
    </p>
    <p class="caption fg-tertiary">{SITE.requirements}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-surface);
    padding-block: var(--x16) var(--x8);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 2fr);
    gap: var(--x12);
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--x2);
    max-width: 32ch;
  }

  .footer__columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--x8);
  }

  .footer__column ul {
    list-style: none;
    margin: var(--x3) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--x2);
  }

  .footer__link {
    color: var(--fg-secondary);
    transition: color var(--t-fast) var(--ease-standard);
  }

  .footer__link:hover {
    color: var(--fg-brand);
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--x3);
    margin-top: var(--x12);
    padding-top: var(--x6);
    border-top: 1px solid var(--border-subtle);
  }

  @media (max-width: 800px) {
    .footer__inner {
      grid-template-columns: 1fr;
      gap: var(--x8);
    }
  }
</style>
