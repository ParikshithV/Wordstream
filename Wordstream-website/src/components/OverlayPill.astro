---
/*
 * The floating overlay, as the app draws it.
 *
 * Same three parts in the same order: the motif whose scale carries the
 * machine's status, a mono eyebrow over a plain-language headline, and — while
 * recording — the waveform with an elapsed timer beside it. The waveform is
 * decorative to a screen reader, so the timer is the real state readout; here
 * the whole pill is a demonstration, so the live region announces the phase
 * instead and the canvas stays hidden.
 *
 * The bars are drawn in a canvas rather than as 32 animated elements because
 * this redraws 30 times a second, and 32 animatable nodes per frame would cost
 * far more than the drawing itself.
 */
import MotifMark from './MotifMark.astro';
---

<div class="pill" data-overlay>
  <div class="pill__motif">
    <!-- One mark, two intensities, exactly as the app draws it: size and
         opacity carry the state, never a different drawing. -->
    <span data-motif="rest"><MotifMark size={26} opacity={0.55} class="fg-brand" /></span>
    <span data-motif="active" hidden><MotifMark size={44} pulse class="fg-brand" /></span>
  </div>

  <div class="pill__body">
    <p class="label fg-tertiary" data-eyebrow>Ready</p>
    <p class="body-sm pill__headline" data-headline>Hold to dictate</p>
  </div>

  <div class="pill__meter" data-meter hidden>
    <canvas data-waveform width="128" height="28" aria-hidden="true"></canvas>
    <p class="mono fg-tertiary" data-timer>0:00</p>
  </div>

  <p class="visually-hidden" aria-live="polite" data-announce></p>
</div>

<style>
  .pill {
    display: flex;
    align-items: center;
    gap: var(--x4);
    min-height: 76px;
    padding: var(--x3) var(--x5);
    border-radius: var(--r-xl);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--e-lg);
  }

  .pill__motif {
    display: grid;
    place-items: center;
    width: 44px;
    flex: none;
  }

  .pill__motif > span {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
  }

  .pill__body {
    flex: 1;
    min-width: 0;
  }

  .pill__headline {
    color: var(--fg-secondary);
    transition: color var(--t-normal) var(--ease-standard);
  }

  .pill__headline[data-preview] {
    color: var(--fg-primary);
  }

  .pill__meter {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--x1);
    flex: none;
  }

  canvas {
    width: 128px;
    height: 28px;
  }

  @media (max-width: 520px) {
    .pill__meter {
      display: none;
    }
  }
</style>

<script>
  interface Phase {
    eyebrow: string;
    headline: string;
    motif: 'rest' | 'active';
    recording?: boolean;
    /** Words that stream into the headline as the live preview would. */
    preview?: string;
    ms: number;
  }

  // The app's own copy, from DictationCoordinator.assistantState.
  const PHASES: Phase[] = [
    { eyebrow: 'Ready', headline: 'Hold to dictate', motif: 'rest', ms: 2200 },
    {
      eyebrow: 'Listening',
      headline: 'Speak now',
      motif: 'rest',
      recording: true,
      preview: 'ship the parser fix before the release, then write up the migration notes',
      ms: 5200,
    },
    {
      eyebrow: 'Transcribing',
      headline: 'Working out what you said',
      motif: 'active',
      ms: 1400,
    },
    { eyebrow: 'Polishing', headline: 'Tidying it up', motif: 'active', ms: 1400 },
    { eyebrow: 'Inserting', headline: 'Placing your text', motif: 'active', ms: 1000 },
  ];

  const root = document.querySelector<HTMLElement>('[data-overlay]');
  if (root) {
    const eyebrow = root.querySelector<HTMLElement>('[data-eyebrow]')!;
    const headline = root.querySelector<HTMLElement>('[data-headline]')!;
    const meter = root.querySelector<HTMLElement>('[data-meter]')!;
    const timer = root.querySelector<HTMLElement>('[data-timer]')!;
    const announce = root.querySelector<HTMLElement>('[data-announce]')!;
    const restMark = root.querySelector<HTMLElement>('[data-motif="rest"]')!;
    const activeMark = root.querySelector<HTMLElement>('[data-motif="active"]')!;
    const canvas = root.querySelector<HTMLCanvasElement>('[data-waveform]')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    // ---- Waveform ------------------------------------------------------

    const BARS = 32;
    const PITCH = 4;
    const WIDTH = 2;
    const levels = new Array<number>(BARS).fill(0);
    let recording = false;
    let energy = 0.35;

    function drawWaveform() {
      const dpr = window.devicePixelRatio || 1;
      const w = canvas.clientWidth || 128;
      const h = canvas.clientHeight || 28;
      if (canvas.width !== w * dpr || canvas.height !== h * dpr) {
        canvas.width = w * dpr;
        canvas.height = h * dpr;
      }

      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);

      const brand = getComputedStyle(document.documentElement)
        .getPropertyValue('--fg-brand')
        .trim();
      ctx.fillStyle = brand || '#3a39ce';
      ctx.globalAlpha = 0.85;

      for (let i = 0; i < BARS; i++) {
        // A floor of 2px keeps the idle waveform a visible flat line rather
        // than nothing at all.
        const height = Math.max(2, Math.min(1, levels[i] * 2.2) * h);
        const x = i * PITCH;
        if (x + WIDTH > w) break;
        ctx.beginPath();
        ctx.roundRect(x, h / 2 - height / 2, WIDTH, height, WIDTH / 2);
        ctx.fill();
      }
    }

    function stepWaveform() {
      // A drifting amplitude with a syllable-scale wobble on top — closer to
      // speech than white noise, without pretending to be a real signal.
      energy += (Math.random() - 0.5) * 0.12;
      energy = Math.min(0.62, Math.max(0.12, energy));
      levels.shift();
      levels.push(recording ? energy * (0.55 + Math.random() * 0.75) : 0);
      drawWaveform();
    }

    let waveTimer: number | undefined;
    if (!reduceMotion.matches) {
      waveTimer = window.setInterval(stepWaveform, 33);
    }
    drawWaveform();

    // ---- Phase machine -------------------------------------------------

    let index = 0;
    let phaseTimer: number | undefined;
    let previewTimer: number | undefined;
    let tickTimer: number | undefined;

    function enter(phase: Phase) {
      eyebrow.textContent = phase.eyebrow;
      headline.textContent = phase.headline;
      headline.removeAttribute('data-preview');
      announce.textContent = `${phase.eyebrow}. ${phase.headline}`;

      restMark.hidden = phase.motif !== 'rest';
      activeMark.hidden = phase.motif !== 'active';

      recording = Boolean(phase.recording);
      meter.hidden = !recording;

      window.clearInterval(previewTimer);
      window.clearInterval(tickTimer);

      if (recording) {
        let elapsed = 0;
        timer.textContent = '0:00';
        tickTimer = window.setInterval(() => {
          elapsed += 1;
          timer.textContent = `${Math.floor(elapsed / 60)}:${String(elapsed % 60).padStart(2, '0')}`;
        }, 1000);

        if (phase.preview && !reduceMotion.matches) {
          const words = phase.preview.split(' ');
          let spoken = 0;
          previewTimer = window.setInterval(() => {
            if (spoken >= words.length) {
              window.clearInterval(previewTimer);
              return;
            }
            spoken += 1;
            headline.textContent = words.slice(0, spoken).join(' ');
            headline.setAttribute('data-preview', '');
          }, 320);
        }
      }
    }

    function advance() {
      enter(PHASES[index]);
      phaseTimer = window.setTimeout(() => {
        index = (index + 1) % PHASES.length;
        advance();
      }, PHASES[index].ms);
    }

    if (reduceMotion.matches) {
      // Static: the first frame of the loop, with no cycling and no stream.
      enter(PHASES[0]);
    } else {
      advance();
    }

    // Stop the whole thing when it isn't on screen — there is no reason to run
    // a 30fps canvas behind the fold.
    const observer = new IntersectionObserver((entries) => {
      const visible = entries.some((entry) => entry.isIntersecting);
      if (visible && waveTimer === undefined && !reduceMotion.matches) {
        waveTimer = window.setInterval(stepWaveform, 33);
      } else if (!visible && waveTimer !== undefined) {
        window.clearInterval(waveTimer);
        waveTimer = undefined;
      }
    });
    observer.observe(root);

    window.addEventListener('pagehide', () => {
      window.clearInterval(waveTimer);
      window.clearTimeout(phaseTimer);
      window.clearInterval(previewTimer);
      window.clearInterval(tickTimer);
    });
  }
</script>
