---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import OverlayPill from '../components/OverlayPill.astro';
import MotifMark from '../components/MotifMark.astro';
import { SITE } from '../lib/site';

const STEPS = [
  {
    n: '01',
    title: 'Hold your key',
    body: 'Right Option by default, or any key or chord you record yourself. Double-tap it for hands-free if you would rather not hold anything. Escape while recording cancels.',
  },
  {
    n: '02',
    title: 'Whisper listens, on this Mac',
    body: 'Audio goes to a Whisper model running locally on the Neural Engine through WhisperKit. Turn on live preview and you watch the words arrive in the overlay as you speak.',
  },
  {
    n: '03',
    title: 'Cleanup turns speech into writing',
    body: 'Filler words go, self-corrections are applied, punctuation and capitalisation are fixed. You choose which engine does it — including one that never leaves the machine.',
  },
  {
    n: '04',
    title: 'The text lands at your cursor',
    body: 'Pasted with the clipboard restored afterwards, or written straight into the focused field through the Accessibility API. Whichever you pick, it works in Electron apps too.',
  },
];

const TIERS = [
  {
    name: 'Automatic',
    tone: 'brand',
    where: 'Best available',
    body: 'Picks the best tier this Mac can actually run right now, and falls back quietly when one becomes unavailable. The default.',
  },
  {
    name: 'Apple Intelligence',
    tone: 'success',
    where: 'On device',
    body: 'The system Foundation Models framework. No download, no key, nothing leaves the Mac. Needs a Mac with Apple Intelligence enabled.',
  },
  {
    name: 'Local model (MLX)',
    tone: 'success',
    where: 'On device',
    body: 'A small instruction-tuned model on this Mac’s GPU through MLX — Gemma 3 1B by default, or any MLX-community model ID you paste in.',
  },
  {
    name: 'Cloud',
    tone: 'warning',
    where: 'Leaves the Mac',
    body: 'Off unless you add an API key, which is stored in the Keychain. Only the transcribed text is sent — never the audio — and only for this step.',
  },
  {
    name: 'Rules only',
    tone: 'neutral',
    where: 'On device',
    body: 'No language model at all. Deterministic cleanup: filler removal, spoken punctuation, spacing, capitalisation, your dictionary.',
  },
];

const STYLES = [
  { name: 'Verbatim', body: 'Change as little as possible — clear errors and sentence-ending punctuation only.' },
  { name: 'Clean up', body: 'Drop fillers and false starts, apply self-corrections, keep your own words and tone.' },
  { name: 'Polished', body: 'Tighten into clear prose while preserving meaning and register.' },
  { name: 'Email', body: 'A short, well-punctuated email body. No greeting or sign-off you did not dictate.' },
  { name: 'Bullets', body: 'A concise bulleted list, one idea per bullet.' },
];

const KNOBS = [
  { label: 'Speech model', body: 'Any Whisper variant WhisperKit offers, from tiny to large-v3. The one Argmax recommends for your Mac is pre-selected.' },
  { label: 'Spoken language', body: 'Pin a language instead of auto-detecting. Far more reliable on a two-second utterance.' },
  { label: 'Live preview', body: 'Stream text into the overlay while you talk. Costs inference as you speak; the inserted text always comes from the final pass.' },
  { label: 'Dictation key', body: 'Record any shortcut. Conflicts with macOS’s own dictation and the emoji picker are flagged, with the fix.' },
  { label: 'Command mode key', body: 'A second, separate shortcut, so dictating an instruction and dictating prose need not share a trigger.' },
  { label: 'Insertion mode', body: 'Paste-and-restore, or write directly through the Accessibility API. The direct path falls back to paste when an app ignores it.' },
  { label: 'Filler removal', body: 'Drop standalone “um”, “uh”, “er” — independently of whichever cleanup tier is running.' },
  { label: 'Spoken punctuation', body: 'Turn “period”, “comma” and “new line” into the punctuation itself.' },
  { label: 'Custom dictionary', body: 'Map what you say to what should be written. Names, product spellings, internal jargon.' },
  { label: 'App awareness', body: 'The cleanup prompt shifts by target app: terse and literal in a terminal, complete sentences in a mail composer.' },
  { label: 'History', body: 'Every dictation kept locally in SwiftData, searchable, copyable, deletable.' },
  { label: 'Appearance', body: 'Six palettes and a light/dark switch — the same ones driving this page. Try the theme control above.' },
];

const FAQ = [
  {
    q: 'Does my audio ever leave the Mac?',
    a: 'No. Transcription is always local — there is no cloud transcription path in the app at all. The only thing that can be sent anywhere is the already-transcribed text, and only if you have deliberately chosen the Cloud cleanup tier and added your own API key.',
  },
  {
    q: 'Why does it need three permissions?',
    a: 'Microphone to hear you, Accessibility to place text into other apps, and Input Monitoring to notice your dictation key while another app is in front. macOS asks for each separately, and each fails silently on its own, so the app checks all three rather than assuming.',
  },
  {
    q: 'Why is it not sandboxed?',
    a: 'It installs a CGEventTap, reads and writes other apps’ text through the Accessibility API, and posts a synthetic ⌘V. None of that is possible inside the App Sandbox. Hardened Runtime is on; the sandbox is deliberately, and visibly, absent from the entitlements file.',
  },
  {
    q: 'Does it work in VS Code, Slack, and other Electron apps?',
    a: 'Yes — that is why paste-and-restore is the default insertion mode. The Accessibility API path is cleaner but silently does nothing in some apps, so it falls back to paste when that happens.',
  },
  {
    q: 'How big is the model download?',
    a: 'It depends which Whisper variant you choose, from tens of megabytes to well over a gigabyte. The download shows real progress rather than an indeterminate spinner, and the app measures how fast the model actually runs on your Mac afterwards so you can judge whether to go smaller.',
  },
  {
    q: 'What does it cost?',
    a: `Nothing. It is ${SITE.license}-licensed and there is no account, no subscription, and no telemetry. If you turn on the optional Cloud cleanup tier, you pay your own provider directly with your own key.`,
  },
];
---

<Layout>
  <!-- ------------------------------------------------------------------ *
       Hero

       The design system allows one page-level gradient and this page, like the
       app's onboarding, declines it. A budget is a ceiling, not a quota — and
       restraint reads as competence. The motif is the only saturated colour.
       * ------------------------------------------------------------------ -->
  <section class="hero">
    <div class="page hero__inner">
      <div class="hero__copy">
        <p class="label fg-tertiary">Open source · macOS · Apple silicon</p>
        <h1 class="display-xl hero__title">
          Dictation that stays<br /> on your Mac.
        </h1>
        <p class="body-lg hero__lede">
          Wordstream is an open-source alternative to Wispr Flow. Hold a key, talk, and your
          words land where your cursor is — transcribed by Whisper running locally, cleaned up
          by whichever model you choose, with every parameter in the open.
        </p>

        <div class="hero__actions">
          <a class="btn btn--primary btn--lg" href="#get">Download for macOS</a>
          <a class="btn btn--secondary btn--lg" href={SITE.repo} rel="noopener">Read the source</a>
        </div>

        <p class="caption fg-tertiary">{SITE.requirements} · {SITE.license} licensed</p>
      </div>

      <div class="hero__demo">
        <OverlayPill />
        <ul class="hero__badges" role="list">
          <li class="badge badge--success">
            <span class="badge__dot"></span><span class="label">Audio never uploaded</span>
          </li>
          <li class="badge badge--brand">
            <span class="badge__dot"></span><span class="label">Swap any model</span>
          </li>
          <li class="badge badge--neutral">
            <span class="badge__dot"></span><span class="label">No account</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section" id="how">
    <div class="page">
      <SectionHeader
        eyebrow="How it works"
        title="Four steps, and you only perform the first one"
        subtitle="The whole product is one keypress long. Everything below it exists so that keypress behaves the same in every app you use."
      />

      <ol class="steps" role="list">
        {
          STEPS.map((step) => (
            <li class="card step">
              <p class="label fg-brand">{step.n}</p>
              <h3 class="heading-sm">{step.title}</h3>
              <p class="body-sm fg-secondary">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Models -->
  <section class="section" id="models">
    <div class="page">
      <SectionHeader
        eyebrow="Speech model"
        title="Whisper runs entirely on this Mac"
        subtitle="Nothing you dictate is uploaded during transcription. Which model does the work, and how it is configured, is yours to decide rather than ours."
      />

      <div class="split">
        <div class="stack" style="gap: var(--x4)">
          <div class="card">
            <h3 class="heading-sm">Every WhisperKit variant, in a list</h3>
            <p class="body-sm fg-secondary">
              tiny through large-v3, plus the distilled and turbo builds, downloaded on demand
              with real progress rather than an indeterminate spinner. The variant Argmax
              recommends for your specific Mac is pre-selected, so choosing one is never a
              blocking step.
            </p>
          </div>

          <div class="card">
            <h3 class="heading-sm">Measured, not guessed</h3>
            <p class="body-sm fg-secondary">
              After a model loads, Wordstream runs one warm-up pass and reports how many
              seconds of audio it processes per second of wall clock on
              <em>your</em> hardware. Below about 1× the live preview will lag your voice, and
              the app says so instead of leaving you to wonder.
            </p>
            <p class="mono metric" aria-label="Example measured real time factor">
              <span class="metric__value">6.4×</span> real time · large-v3-turbo
            </p>
          </div>
        </div>

        <div class="card card--alt stack" style="gap: var(--x4)">
          <MotifMark size={64} class="fg-brand" />
          <h3 class="heading-sm">Parameters, not presets</h3>
          <p class="body-sm fg-secondary">
            A closed dictation app gives you a quality slider. This one gives you the model
            variant, the pinned language, whether streaming transcription runs at all, the
            cleanup engine, the cleanup style, the model ID that engine loads, and the prompt
            contract it runs under — all readable in the repository, all changeable in
            Settings.
          </p>
          <a class="btn btn--ghost" href={SITE.repo} rel="noopener">Browse the source →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Cleanup -->
  <section class="section" id="cleanup">
    <div class="page">
      <SectionHeader
        eyebrow="Cleanup"
        title="Turning speech into writing"
        subtitle="Rule-based cleanup always runs. A language model on top of it removes filler words, applies your self-corrections, and fixes punctuation — and you choose which model, including none."
      />

      <ul class="tiers" role="list">
        {
          TIERS.map((tier) => (
            <li class="card tier">
              <div class="tier__head">
                <h3 class="heading-sm">{tier.name}</h3>
                <span class:list={['badge', `badge--${tier.tone}`]}>
                  <span class="badge__dot" />
                  <span class="label">{tier.where}</span>
                </span>
              </div>
              <p class="body-sm fg-secondary">{tier.body}</p>
            </li>
          ))
        }
      </ul>

      <div class="subsection">
        <SectionHeader
          eyebrow="Style"
          title="How much to change"
          size="sm"
          subtitle="Independent of which engine runs it. The prompt is deliberately narrow: the failure mode for a dictation cleaner is not a clumsy rewrite, it is the model deciding your transcript was a question and answering it."
        />
        <dl class="styles">
          {
            STYLES.map((style) => (
              <div class="styles__row">
                <dt class="body-sm medium">{style.name}</dt>
                <dd class="body-sm fg-secondary">{style.body}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- Everything you can change -->
  <section class="section" id="knobs">
    <div class="page">
      <SectionHeader
        eyebrow="Settings"
        title="Everything you can change"
        subtitle="Not an exhaustive list because it is a short one — an exhaustive list because there is nothing hidden behind it."
      />

      <ul class="knobs" role="list">
        {
          KNOBS.map((knob) => (
            <li class="knob">
              <p class="body-sm medium">{knob.label}</p>
              <p class="caption fg-tertiary">{knob.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Privacy -->
  <section class="section" id="privacy">
    <div class="page">
      <SectionHeader
        eyebrow="Privacy"
        title="What leaves your Mac, and exactly when"
        subtitle="Stated as a rule rather than a promise, because the code is right there."
      />

      <div class="privacy">
        <div class="card privacy__card">
          <span class="badge badge--success">
            <span class="badge__dot"></span><span class="label">Never leaves</span>
          </span>
          <ul class="ticks body-sm" role="list">
            <li>Your audio. There is no cloud transcription path in the app.</li>
            <li>Your dictation history, kept locally in SwiftData.</li>
            <li>Your custom dictionary.</li>
            <li>Your settings, shortcuts and palette.</li>
            <li>Anything at all, if you leave the Cloud tier off — which is the default.</li>
          </ul>
        </div>

        <div class="card privacy__card">
          <span class="badge badge--warning">
            <span class="badge__dot"></span><span class="label">Only if you opt in</span>
          </span>
          <ul class="ticks body-sm" role="list">
            <li>The transcribed <em>text</em>, sent to the cleanup provider you pick.</li>
            <li>Requires an API key you supply, stored in the macOS Keychain.</li>
            <li>Never the audio, and never anything else in the app.</li>
            <li>Model weights, downloaded once from Hugging Face.</li>
          </ul>
        </div>
      </div>

      <p class="body-sm fg-tertiary privacy__note measure">
        No account, no sign-in, no telemetry, no analytics, no crash reporting service. The app
        makes no network request you did not ask for.
      </p>
    </div>
  </section>

  <!-- Get it -->
  <section class="section" id="get">
    <div class="page">
      <SectionHeader
        eyebrow="Get Wordstream"
        title="Download it, or build it yourself"
        subtitle="Both paths lead to the same app. One of them lets you read every line first."
      />

      <div class="split" id="build">
        <div class="card stack" style="gap: var(--x4)">
          <MotifMark size={32} class="fg-brand" />
          <h3 class="heading-sm">Download the release</h3>
          <p class="body-sm fg-secondary">
            A signed build for {SITE.requirements.toLowerCase()}. On first launch it walks you
            through the three permissions and picks a speech model for your machine.
          </p>
          <div class="hero__actions">
            <a class="btn btn--primary" href={SITE.releases} rel="noopener">Latest release</a>
          </div>
        </div>

        <div class="card stack" style="gap: var(--x4)">
          <MotifMark size={32} class="fg-brand" />
          <h3 class="heading-sm">Build from source</h3>
          <p class="body-sm fg-secondary">
            Clone it, open it in Xcode, hit run. Swift package dependencies resolve on first
            build.
          </p>
          <pre><code>git clone {SITE.repo}.git
cd Wordstream
open Wordstream.xcodeproj</code></pre>
          <p class="caption fg-tertiary">
            Requires Xcode 16 or later. The app is not sandboxed by design — see the FAQ.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq">
    <div class="page">
      <SectionHeader eyebrow="FAQ" title="Reasonable questions" />

      <div class="faq">
        {
          FAQ.map((item, i) => (
            <details class="card faq__item" open={i === 0}>
              <summary>
                <span class="heading-sm">{item.q}</span>
                <span class="faq__marker" aria-hidden="true" />
              </summary>
              <p class="body-sm fg-secondary">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---- Hero ---- */

  .hero {
    padding-block: var(--x24) var(--x20);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: var(--x16);
    align-items: center;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--x5);
  }

  .hero__title {
    margin-top: calc(-1 * var(--x2));
  }

  .hero__lede {
    color: var(--fg-secondary);
    max-width: 54ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--x3);
  }

  .hero__demo {
    display: flex;
    flex-direction: column;
    gap: var(--x4);
  }

  .hero__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--x2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ---- Steps ---- */

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--x4);
    list-style: none;
    margin: var(--x10) 0 0;
    padding: 0;
    counter-reset: step;
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: var(--x2);
  }

  /* ---- Split layout ---- */

  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--x4);
    margin-top: var(--x10);
    align-items: start;
  }

  .metric {
    margin-top: var(--x3);
    padding-top: var(--x3);
    border-top: 1px solid var(--border-subtle);
    color: var(--fg-tertiary);
  }

  .metric__value {
    color: var(--fg-brand);
    font-weight: 500;
    font-size: 15px;
  }

  /* ---- Cleanup tiers ---- */

  .tiers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--x4);
    list-style: none;
    margin: var(--x10) 0 0;
    padding: 0;
  }

  .tier {
    display: flex;
    flex-direction: column;
    gap: var(--x3);
  }

  .tier__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--x2);
  }

  .subsection {
    margin-top: var(--x16);
  }

  .styles {
    margin: var(--x6) 0 0;
    border-top: 1px solid var(--border-subtle);
  }

  .styles__row {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: var(--x4);
    padding-block: var(--x4);
    border-bottom: 1px solid var(--border-subtle);
  }

  .styles__row dd {
    margin: 0;
    color: var(--fg-secondary);
  }

  /* ---- Knobs ---- */

  .knobs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--x6) var(--x8);
    list-style: none;
    margin: var(--x10) 0 0;
    padding: 0;
  }

  .knob {
    display: flex;
    flex-direction: column;
    gap: var(--x1);
    padding-left: var(--x4);
    border-left: 2px solid var(--border-brand);
  }

  /* ---- Privacy ---- */

  .privacy {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--x4);
    margin-top: var(--x10);
  }

  .privacy__card {
    display: flex;
    flex-direction: column;
    gap: var(--x4);
    align-items: flex-start;
  }

  .ticks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--x3);
    color: var(--fg-secondary);
  }

  .ticks li {
    position: relative;
    padding-left: var(--x5);
  }

  .ticks li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 6px;
    height: 6px;
    border-radius: var(--r-pill);
    background: var(--fg-brand);
  }

  .privacy__note {
    margin-top: var(--x6);
  }

  /* ---- FAQ ---- */

  .faq {
    display: flex;
    flex-direction: column;
    gap: var(--x3);
    margin-top: var(--x10);
    max-width: 860px;
  }

  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--x4);
    min-height: var(--tap-target);
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__marker {
    position: relative;
    flex: none;
    width: 16px;
    height: 16px;
    color: var(--fg-brand);
  }

  .faq__marker::before,
  .faq__marker::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    transition: transform var(--t-normal) var(--ease-standard);
  }

  .faq__marker::after {
    transform: rotate(90deg);
  }

  .faq__item[open] .faq__marker::after {
    transform: rotate(0deg);
  }

  .faq__item p {
    margin-top: var(--x3);
    max-width: var(--measure);
  }

  /* ---- Responsive ---- */

  @media (max-width: 960px) {
    .hero {
      padding-block: var(--x16) var(--x12);
    }

    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--x10);
    }
  }

  @media (max-width: 560px) {
    .styles__row {
      grid-template-columns: 1fr;
      gap: var(--x1);
    }
  }
</style>
